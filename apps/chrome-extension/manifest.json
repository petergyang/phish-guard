{
  "manifest_version": 3,
  "name": "Phish Guard",
  "version": "0.1.0",
  "description": "Shows local phishing warnings in Gmail when a sender may be impersonating a brand.",
  "action": {
    "default_title": "Phish Guard",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://mail.google.com/*"
  ]
}
