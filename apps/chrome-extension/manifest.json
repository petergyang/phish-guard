{
  "manifest_version": 3,
  "name": "Phish Guard",
  "version": "0.2.3",
  "description": "Shows local phishing warnings in Gmail when a sender may be impersonating a brand.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Phish Guard",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "https://mail.google.com/*"
  ]
}
